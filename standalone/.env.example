# --- Enable Banking ----------------------------------------------------------
# Application ID fra https://enablebanking.com/cp/applications (samme som .pem-filnavnet)
EB_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# Skal være registreret på din Enable Banking-application
EB_REDIRECT_URL=http://localhost:8080/auth_redirect
# Spar Nord kører nu som brand under Nykredit. Kør "python -m app.cli check" for at se det præcise navn.
ASPSP_NAME=Spar Nord
ASPSP_COUNTRY=DK
PSU_TYPE=personal
CONSENT_DAYS=180

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:////data/bank.db
# DATABASE_URL=postgresql+psycopg://bank2ha:secret@db:5432/bank2ha
# DATABASE_URL=mysql+pymysql://bank2ha:secret@core-mariadb:3306/bank2ha

# --- Sync --------------------------------------------------------------------
# PSD2 tillader typisk kun 4 automatiske opslag pr. konto pr. døgn -> 360 min er sikkert
SYNC_INTERVAL_MINUTES=360
INITIAL_HISTORY_DAYS=730
OVERLAP_DAYS=10
RULES_PATH=/config/rules.yaml
TZ=Europe/Copenhagen

# --- MQTT / Home Assistant ---------------------------------------------------
MQTT_ENABLED=true
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=bank2ha
MQTT_PASSWORD=change-me
MQTT_TLS=false
MQTT_BASE_TOPIC=bank2ha
HA_DISCOVERY_PREFIX=homeassistant
# false = modpart og posteringstekst sendes IKKE til HA (kun beløb/kategori)
PUBLISH_TRANSACTION_DETAILS=true
LARGE_TRANSACTION_THRESHOLD=2000

# --- Web UI ------------------------------------------------------------------
BIND_ADDR=127.0.0.1
UI_USERNAME=admin
UI_PASSWORD=
